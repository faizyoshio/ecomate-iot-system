  {
    "id": "split_payload",
    "type": "function",
    "z": "tab_ecomate",
    "name": "Parser Telemetri",
    "func": "var data = msg.payload;\nvar p_suhu = { payload: Number(data.suhu || 0), topic: 'Suhu' };\nvar p_kelembaban = { payload: Number(data.kelembaban || 0), topic: 'Kelembaban' };\nvar p_ph = { payload: Number(data.ph || 0), topic: 'pH' };\nvar p_motor = { payload: data.motor ? 'Aktif (17.5 RPM)' : 'Standby' };\nreturn [p_suhu, p_kelembaban, p_ph, p_motor];",
    "outputs": 4,
    "noerr": 0,
    "x": 380,
    "y": 180,
    "wires": [
      [
        "gauge_suhu",
        "chart_bioproses",
        "check_suhu_kritis"
      ],
      [
        "gauge_kelembaban",
        "chart_bioproses"
      ],
      [
        "gauge_ph",
        "chart_ph"
      ],
      [
        "text_motor_status"
      ]
    ]
  },
