  {
    "id": "csv_formatter",
    "type": "function",
    "z": "tab_ecomate",
    "name": "Format Baris CSV",
    "func": "var d = new Date();\nvar tgl = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0') + ' ' + String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0') + ':' + String(d.getSeconds()).padStart(2,'0');\nvar data = msg.payload;\nvar row = tgl + ',' + (data.suhu || 0) + ',' + (data.kelembaban || 0) + ',' + (data.ph || 0) + ',' + (data.motor ? 1 : 0) + '\\n';\nmsg.payload = row;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 380,
    "y": 280,
    "wires": [
      [
        "file_logger",
        "ui_last_log"
      ]
    ]
  },
