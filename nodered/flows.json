  {
    "id": "prep_wa",
    "type": "function",
    "z": "tab_ecomate",
    "name": "Format WA",
    "func": "msg.headers = { 'Authorization': 'TOKEN_FONNTE' };\nmsg.payload = {\n    'target': '081234567890',\n    'message': '[ECO-MATE] Suhu biomassa melebihi 70\u00b0C (' + msg.payload.toFixed(1) + '\u00b0C). Harap periksa aerasi drum.'\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 830,
    "y": 60,
    "wires": [
      [
        "http_fonnte"
      ]
    ]
  },
