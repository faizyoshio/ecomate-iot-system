  {
    "id": "ui_responsive_css",
    "type": "ui_template",
    "z": "tab_ecomate",
    "pagePath": "",
    "name": "UI/UX Pro Max Styling",
    "group": "grp_sensors",
    "order": 1,
    "width": 0,
    "height": 0,
    "format": "<style>\n  /* UI/UX PRO MAX - Minimalist Clean Industrial Design */\n  * {\n    -webkit-tap-highlight-color: transparent !important;\n    box-sizing: border-box !important;\n  }\n\n  html, body {\n    overflow-x: hidden !important;\n    background-color: #0b0f19 !important;\n    font-family: -apple-system, BlinkMacSystemFont, \"Inter\", \"Segoe UI\", Roboto, sans-serif !important;\n    color: #f1f5f9 !important;\n  }\n\n  /* Header Toolbar Clean */\n  md-toolbar.md-default-theme, md-toolbar {\n    background-color: #0b0f19 !important;\n    border-bottom: 1px solid #1e293b !important;\n    color: #f8fafc !important;\n  }\n  .md-toolbar-tools {\n    font-weight: 700 !important;\n    letter-spacing: 0.05em !important;\n  }\n\n  /* Layout Container */\n  .nr-dashboard-cardpanel {\n    padding: 6px !important;\n    margin: 0 auto !important;\n    max-width: 100vw !important;\n    display: flex !important;\n    flex-wrap: wrap !important;\n    justify-content: center !important;\n    gap: 8px !important;\n  }\n\n  /* Cards - Professional Slate Border */\n  md-card {\n    border-radius: 12px !important;\n    background: #111827 !important;\n    border: 1px solid #1f2937 !important;\n    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3) !important;\n    transition: border-color 0.2s ease, box-shadow 0.2s ease !important;\n  }\n  md-card:hover {\n    border-color: #374151 !important;\n  }\n\n  /* Section Title - Clean Uppercase Subhead */\n  .nr-dashboard-cardtitle {\n    font-size: 13px !important;\n    font-weight: 700 !important;\n    color: #94a3b8 !important;\n    text-transform: uppercase !important;\n    letter-spacing: 0.06em !important;\n    padding: 10px 14px 2px 14px !important;\n  }\n\n  /* Gauges Crisp Display */\n  .nr-dashboard-gauge svg {\n    max-width: 100% !important;\n    height: auto !important;\n  }\n  .nr-dashboard-gauge-title {\n    font-weight: 600 !important;\n    font-size: 13px !important;\n    color: #cbd5e1 !important;\n  }\n\n  /* Interactive Button - Modern Solid Pill */\n  md-button {\n    min-height: 48px !important;\n    border-radius: 8px !important;\n    font-size: 14px !important;\n    font-weight: 600 !important;\n    letter-spacing: 0.02em !important;\n    background-color: #2563eb !important;\n    color: #ffffff !important;\n    box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3) !important;\n    transition: all 0.15s ease !important;\n  }\n  md-button:hover {\n    background-color: #1d4ed8 !important;\n  }\n  md-button:active {\n    transform: scale(0.98) !important;\n  }\n\n  /* Switches Clean */\n  md-switch {\n    margin: 8px 14px !important;\n  }\n  md-switch .md-label {\n    font-size: 14px !important;\n    font-weight: 500 !important;\n    color: #e2e8f0 !important;\n  }\n  md-switch.md-checked .md-bar {\n    background-color: #10b981 !important;\n  }\n  md-switch.md-checked .md-thumb {\n    background-color: #34d399 !important;\n  }\n\n  /* Text elements */\n  .nr-dashboard-text {\n    padding: 6px 14px !important;\n  }\n\n  /* Monospace Logger */\n  md-card[title*=\"Log\"] pre, .nr-dashboard-text p {\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;\n  }\n\n  @media screen and (max-width: 600px) {\n    .nr-dashboard-cardpanel {\n      padding: 4px !important;\n    }\n  }\n</style>\n",
    "storeOutMessages": false,
    "fwdInMessages": false,
    "resendOnRefresh": false,
    "templateScope": "global",
    "x": 380,
    "y": 100,
    "wires": [
      []
    ]
  }
